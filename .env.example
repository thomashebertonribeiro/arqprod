# ---- Database ----
DATABASE_URL=postgresql://arqprod:arqprod_secret@postgres:5432/arqprod

# ---- Redis (fila de webhooks/sincronização) ----
REDIS_URL=redis://redis:6379

# ---- Segredos ----
# Gere com: openssl rand -hex 32
JWT_SECRET=change-me-please-use-openssl-rand-hex-32
# Gere com: openssl rand -hex 32  (usado no hash HMAC das API keys)
API_KEY_HASH_SALT=change-me-please-use-openssl-rand-hex-32

# ---- App ----
NODE_ENV=production
PORT=3000
# URL pública (usada nos payloads de webhook e links absolutos)
PUBLIC_APP_URL=https://seu-dominio.com

# ---- Credenciais do usuário admin criado pelo seed ----
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=admin123456
SEED_ORG_SLUG=exemplo